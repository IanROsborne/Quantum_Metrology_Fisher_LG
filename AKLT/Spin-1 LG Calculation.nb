Cell[TextData[{
 "The strong measure formula can be used to calculate both ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["q", "TI"]], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "C_q(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0188999-8fd6-0a4e-84ff-19ea5d1b1fd3"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"1", "-", 
            SuperscriptBox[
             StyleBox["q", "TI"], "2"]}]], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "C_{1 - q^2}(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85d7d81a-9291-8745-a859-0ccc5235f236"],
 ".\n\nLOW TEMPERATURE"
}], "Text",
 CellChangeTimes->{{3.998428696163063*^9, 3.9984287017381516`*^9}, {
   3.9984297251737614`*^9, 3.998429729685259*^9}, 3.9985796132824593`*^9, {
   3.998654937039921*^9, 3.998654968429846*^9}, {3.99865501206732*^9, 
   3.998655031190628*^9}, {3.998656188678444*^9, 
   3.9986562016489143`*^9}},ExpressionUUID->"d6e6011d-ce8d-ba4f-941c-\
5388812cb439"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"K3StrongMeasure", "[", 
   RowBox[{"\[Beta]_", ",", "op_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"2", 
    RowBox[{"CqStrongMeasure", "[", 
     RowBox[{"\[Beta]", ",", "op", ",", "t"}], "]"}]}], "-", 
   RowBox[{"CqStrongMeasure", "[", 
    RowBox[{"\[Beta]", ",", "op", ",", 
     RowBox[{"2", "t"}]}], "]"}], "+", 
   RowBox[{"COneMinusQSquaredStrongMeasure", "[", 
    RowBox[{"\[Beta]", ",", "op", ",", 
     RowBox[{"2", "t"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K2StrongMeasure", "[", 
   RowBox[{"\[Beta]_", ",", "op_", ",", "t_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"2", 
    RowBox[{"CqStrongMeasure", "[", 
     RowBox[{"\[Beta]", ",", "op", ",", "t"}], "]"}]}], "-", 
   RowBox[{"CqStrongMeasure", "[", 
    RowBox[{"\[Beta]", ",", "op", ",", 
     RowBox[{"2", "t"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"K3StrongMeasure", "[", 
      RowBox[{"100", ",", "\[CapitalPi]S\[Theta]3Level", ",", "t"}], "]"}], ",", 
     RowBox[{"K2StrongMeasure", "[", 
      RowBox[{"100", ",", "\[CapitalPi]S\[Theta]3Level", ",", "t"}], "]"}], ",",
      "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", "Pi"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3.1"}], ",", "1.6"}], "}"}]}], ",", 
   RowBox[{"Filling", "->", 
    RowBox[{"{", 
     RowBox[{"3", "->", "Bottom"}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(K\), \(3\)]\)(t)\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(K\), \(2\)]\)(t)\>\"", 
      ",", "\"\<Macrorealism Regime\>\""}], "}"}]}]}], "]"}]}], "Input",
