Cell[TextData[{
 "Which is simply a cosine function. The Leggett-Garg function defined as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["K", "TI"], "2"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", "2", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["q", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "-", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["q", "TI"]], 
         RowBox[{"(", 
